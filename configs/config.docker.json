{
    "gateway": {
        "http_addr": ":8080",
        "tcp_addr": ":8081",
        "transport": "both",
        "heartbeat": "30s",
        "heartbeat_fail": 3,
        "check_origin": ["http://localhost", "http://localhost:80"],

        "conn": {
            "pong_wait": "60s",
            "ping_period": "54s",
            "max_msg_size": 65536,
            "send_buf_size": 256,
            "offline_max_size": 1000
        },

        "rate_limit": {
            "enabled": true,
            "rate": 10,
            "burst": 20,
            "cleanup_interval": "5m"
        },

        "redis": {
            "addr": "redis:6379",
            "password": "",
            "db": 0
        },

        "gnet": {
            "num_event_loops": 0,
            "worker_pool_size": 0
        },

        "mysql": {
            "enabled": true,
            "dsn": "im:im-dev@tcp(mysql:3306)/im?parseTime=true&charset=utf8mb4",
            "max_open_conns": 32,
            "max_idle_conns": 16,
            "conn_max_lifetime": "30m",
            "conn_max_idle_time": "5m"
        },

        "auth": {
            "dev_mode": false
        },

        "kafka": {
            "enabled": true,
            "brokers": ["kafka:9093"],
            "topic": "im.message.persist"
        },

        "logic": {
            "addr": "logic:50051",
            "listen_addr": ":50051"
        },

        "grpc": {
            "addr": "",
            "node_id": "",
            "peer_addrs": {}
        },

        "object_storage": {
            "enabled": true,
            "endpoint": "rustfs:9000",
            "access_key": "rustfsadmin",
            "secret_key": "rustfsadmin",
            "bucket": "im-files",
            "use_ssl": false,
            "max_upload": 104857600,
            "legacy_max_upload": 10485760,
            "public_endpoint": "http://localhost:9000",
            "region": "us-east-1",
            "cors_allowed_origins": ["http://localhost:5173"],
            "presign_upload_ttl": "15m",
            "presign_download_ttl": "1h"
        },

        "recall_window_ms": 120000,
        "history_default_limit": 30,
        "search_default_limit": 20,
        "dedup_ttl": "5m",
        "persist_concurrency": 64,
        "persist_queue_size": 8192,
        "persist_batch_size": 200,
        "persist_flush_interval": "10ms",
        "persist_batch_workers": 2,
        "persist_enqueue_timeout": "10ms",
        "persist_max_retries": 3
    },

    "admin_uids": ["SixForOne"],

    "admin_email": "",

    "logic": {
        "addr": "logic:50051",
        "listen_addr": ":50051",
        "mysql": { "enabled": true, "dsn": "im:im-dev@tcp(mysql:3306)/im?parseTime=true&charset=utf8mb4" },
        "kafka": { "enabled": true, "brokers": ["kafka:9093"], "topic": "im.message.persist" },
        "worker_id": 2
    },

    "stability": {
        "max_connections": 0,
        "http_read_timeout": "10s",
        "http_write_timeout": "10s",
        "http_idle_timeout": "120s",
        "shutdown_timeout": "30s",
        "pprof_enabled": false,
        "metrics_enabled": true
    },

    "jwt": {
        "secret": "change-me-in-production",
        "expiration": "168h"
    },

    "snowflake": {
        "worker_id": 1
    }
}
